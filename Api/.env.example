# URL pública do site web após o deploy no Render (sem barra final).
NODE_ENV=development
CORS_ORIGINS=http://localhost:5173,https://diario-de-aula-web.onrender.com
PORT=3333
DATABASE_URL=

# IA: mantenha a chave real exclusivamente no .env, nunca neste arquivo.
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview

# Spotify OAuth. Crie o app em developer.spotify.com e informe o callback abaixo.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://localhost:3333/api/v1/integrations/spotify/callback
