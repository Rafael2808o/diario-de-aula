# URL pública do site web após o deploy no Render (sem barra final).
NODE_ENV=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://diario-de-aula-web.onrender.com
PORT=3333
DATABASE_URL=

# IA: mantenha a chave real exclusivamente no .env, nunca neste arquivo.
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Spotify Premium usa Authorization Code com PKCE; o segredo não fica no projeto.
# Cadastre como redirect URI: http://127.0.0.1:5173/?spotify=callback
# Em produção: https://diario-de-aula-web.vercel.app/?spotify=callback
SPOTIFY_CLIENT_ID=
