{
  "expo": {
    "owner": "docvia-app",
    "name": "Grimiau",
    "slug": "diario-de-aula",
    "version": "1.5.0",
    "icon": "./assets/icon.png",
    "orientation": "default",
    "scheme": "estuda",
    "userInterfaceStyle": "light",
    "android": {
      "package": "com.estuda.diariodeaula",
      "versionCode": 8,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#4F5BD5"
      },
      "permissions": [
        "RECORD_AUDIO",
        "MODIFY_AUDIO_SETTINGS"
      ]
    },
    "ios": {
      "bundleIdentifier": "com.estuda.diariodeaula",
      "buildNumber": "8",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSMicrophoneUsageDescription": "O Grimiau usa o microfone só quando você grava uma aula com autorização."
      }
    },
    "plugins": [
      "expo-status-bar"
    ],
    "extra": {
      "eas": {
        "projectId": "d641c4b3-1631-4e10-b03a-765ef6a916e3"
      }
    }
  }
}
