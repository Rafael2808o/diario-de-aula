{
  "expo": {
    "owner": "docvia-app",
    "name": "Grimiau",
    "slug": "diario-de-aula",
    "version": "1.6.0",
    "icon": "./assets/icon.png",
    "orientation": "default",
    "scheme": "estuda",
    "userInterfaceStyle": "light",
    "android": {
      "package": "com.estuda.diariodeaula",
      "versionCode": 9,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#4F5BD5"
      },
      "permissions": [
        "RECORD_AUDIO",
        "MODIFY_AUDIO_SETTINGS",
        "CAMERA"
      ]
    },
    "ios": {
      "bundleIdentifier": "com.estuda.diariodeaula",
      "buildNumber": "9",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSMicrophoneUsageDescription": "O Grimiau usa o microfone quando você grava uma aula ou entra numa chamada do grupo, sempre com sua autorização.",
        "NSCameraUsageDescription": "O Grimiau usa a câmera só quando você a liga numa chamada do grupo ou tira uma foto para o Feed."
      }
    },
    "plugins": [
      "expo-status-bar"
    ],
    "extra": {
      "eas": {
        "projectId": "d641c4b3-1631-4e10-b03a-765ef6a916e3"
      }
    }
  }
}
